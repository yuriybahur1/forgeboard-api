WORKSTREAM_ENVIRONMENT=local
WORKSTREAM_DATABASE_URL=postgresql+psycopg://workstream:workstream@postgres:5432/workstream
WORKSTREAM_ASYNC_DATABASE_URL=postgresql+psycopg_async://workstream:workstream@postgres:5432/workstream
WORKSTREAM_REDIS_URL=redis://redis:6379/0
WORKSTREAM_JWT_SECRET=local-only-change-me-please-32-chars
WORKSTREAM_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
WORKSTREAM_CORS_ORIGINS=[]
WORKSTREAM_SMTP_HOST=mailpit
WORKSTREAM_SMTP_PORT=1025
WORKSTREAM_PUBLIC_URL=http://localhost:8000
WORKSTREAM_LOGIN_RATE_LIMIT=10
WORKSTREAM_PASSWORD_RESET_RATE_LIMIT=5
WORKSTREAM_VERIFICATION_RATE_LIMIT=3
WORKSTREAM_INVITATION_RATE_LIMIT=20
WORKSTREAM_OUTBOX_CLAIM_SECONDS=120
WORKSTREAM_OUTBOX_MAX_ATTEMPTS=10
